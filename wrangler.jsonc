{
  // Cloudflare Workers + 静态资源项目配置。
  // 面板构建设置：构建命令 npm run build ｜ 部署命令 npx wrangler deploy ｜ 预览命令 npx wrangler dev
  // 本地手动部署：npm run deploy
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "v-song-list",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "./dist",
    // 未命中静态资源的路径一律回 index.html 并返回 200（SPA 回退）
    "not_found_handling": "single-page-application"
  }
}
